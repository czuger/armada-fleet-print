# Deploy settings (deploy/config.sh). Copy to .env, which is gitignored, and fill in.
# A variable already set in the environment wins over this file.

# SSH destination of the server, and the app's directory there.
SSH_HOST=user@server
REMOTE_DIR=/home/user/armada-fleet-print

# Host directory where the app puts its socket, bind-mounted into the nginx container.
SOCKET_DIR=/home/user/nginx_proxy/sockets

# The dockerized nginx: its container name, and the host directory its server{}
# includes *.conf from.
NGINX_CONTAINER=nginx-proxy
NGINX_CONF_DIR=/home/user/nginx_proxy/sites/apps

# Optional, with their defaults:
# NGINX_SOCKET_DIR=/sockets
# URL_PREFIX=/armada
# BUILD_TARGET=x86_64-unknown-linux-gnu
# KEEP_RELEASES=3
